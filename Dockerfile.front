# Streamlit front-end
FROM python:3.11-slim

WORKDIR /app

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt streamlit pandas altair requests

# Copy dashboard code
COPY crypto_dashboard.py .

EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "crypto_dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
